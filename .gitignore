# ESP-IDF Build artifacts
build*/
**/build*/

# ESP-IDF component manager & lockfiles
managed_components/
**/managed_components/
dependencies.lock
**/dependencies.lock
**/dependencies.lock.*

# ESP-IDF SDK configuration (generated from sdkconfig.defaults)
sdkconfig
sdkconfig.old
**/sdkconfig
**/sdkconfig.old

# Wi-Fi Credentials & Secrets (NEVER COMMIT TO GIT)
wifi_credentials.h
wifi_credentials.c
*wifi_credentials.h
*wifi_credentials.c
**/wifi_credentials.h
**/wifi_credentials.c

# IDE / Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosv
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db

# Audio data files & copyright-protected media
data/mp3/*
!data/mp3/.gitkeep
*.mp3
*.aup3

# Python caches and environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv*/
.venv*/
scratch/
