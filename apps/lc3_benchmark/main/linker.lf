[mapping:esp_audio_codec]
archive: libesp_audio_codec.a
entries:
    if LC3_CODE_IN_IRAM = y:
        esp_lc3_enc (noflash)
        esp_lc3_dec (noflash)
        lc3_attack_detector_fx (noflash)
        lc3_band_detector_fx (noflash)
        lc3_constant_fx (noflash)
        lc3_dct2 (noflash)
        lc3_dec (noflash)
        lc3_enc (noflash)
        lc3_global_gain (noflash)
        lc3_ltpf (noflash)
        lc3_mdct (noflash)
        lc3_mem (noflash)
        lc3_nf_quant_gain (noflash)
        lc3_plc_fx (noflash)
        lc3_res_ari_bit (noflash)
        lc3_rsp_128_fx (noflash)
        lc3_sns_dec (noflash)
        lc3_sns_enc_fx (noflash)
        lc3_tns_dec (noflash)
        lc3_tns_enc_fx (noflash)
        lc3_attack_detector_hp_filter (noflash)
        lc3_band_detector_find_nyquest (noflash)
        lc3_cal_nf_seed (noflash)
        lc3_find_max (noflash)
        lc3_global_gain_opt (noflash)
        lc3_hotspots (noflash)
        lc3_loop_shift (noflash)
        lc3_mdct_base (noflash)
        lc3_sns_enc_band_energy (noflash)
        lc3_sns_enc_smooth (noflash)
        lc3_util (noflash)
    else:
        esp_lc3_enc (default)
        esp_lc3_dec (default)
        lc3_attack_detector_fx (default)
        lc3_band_detector_fx (default)
        lc3_constant_fx (default)
        lc3_dct2 (default)
        lc3_dec (default)
        lc3_enc (default)
        lc3_global_gain (default)
        lc3_ltpf (default)
        lc3_mdct (default)
        lc3_mem (default)
        lc3_nf_quant_gain (default)
        lc3_plc_fx (default)
        lc3_res_ari_bit (default)
        lc3_rsp_128_fx (default)
        lc3_sns_dec (default)
        lc3_sns_enc_fx (default)
        lc3_tns_dec (default)
        lc3_tns_enc_fx (default)
        lc3_attack_detector_hp_filter (default)
        lc3_band_detector_find_nyquest (default)
        lc3_cal_nf_seed (default)
        lc3_find_max (default)
        lc3_global_gain_opt (default)
        lc3_hotspots (default)
        lc3_loop_shift (default)
        lc3_mdct_base (default)
        lc3_sns_enc_band_energy (default)
        lc3_sns_enc_smooth (default)
        lc3_util (default)

